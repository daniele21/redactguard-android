{
  "schema_version": 1,
  "contract_version": "0.3.0",
  "commands": {
    "setup": {"status": "required", "run": "./gradlew --version"},
    "doctor": {"status": "recommended", "run": "bash scripts/doctor-android.sh"},
    "dev": {"status": "recommended", "run": "./gradlew :app:installDebug"},
    "check": {"status": "required", "run": "./gradlew spotlessCheck :app:lintDebug"},
    "test": {"status": "required", "run": "./gradlew :app:testDebugUnitTest"},
    "e2e": {"status": "n/a", "note": "RTA-10 will wire the physical two-APK critical journey once packaged-app/device cleanup is executable."},
    "build": {"status": "required", "run": "bash scripts/package-redactguard-artifact.sh debug"},
    "smoke": {"status": "n/a", "note": "RTA-10 will add an install/launch/minimal-path smoke command against a built APK."},
    "package": {"status": "optional", "run": "bash scripts/build-redactguard-release.sh build"},
    "stop": {"status": "n/a", "note": "RedactGuard owns no localhost/server runtime; Android process lifecycle is platform/device-owned."},
    "clean": {"status": "required", "run": "./gradlew clean && rm -rf artifacts/.staging"}
  },
  "end_to_end": {
    "recommended_when_full_workflow_boundary_exists": true,
    "critical_journeys_prioritized": true,
    "lower_level_tests_remain_primary": true,
    "use_stack_native_tooling": true,
    "run_against_built_artifact_when_material": true,
    "failure_evidence_bounded": true,
    "zero_residue_required": true
  },
  "build_identity": {
    "unique_per_build": true,
    "source_revision_required": true,
    "dirty_state_required": true,
    "lineage_fields": ["project", "platform", "architecture", "channel", "variant"],
    "artifact_name_fields": ["product", "product_version", "build_id", "source_revision"]
  },
  "artifact_lifecycle": {
    "immutable_successful_artifacts": true,
    "promote_only_after_success": true,
    "manifest_required": true,
    "manifest_name": "manifest.json",
    "checksum_algorithm": "sha256",
    "local_keep_successful_per_lineage": 2,
    "ci_store": "github-actions",
    "ci_retention_days": 7,
    "release_store": "google-play-or-explicit-release-channel",
    "release_artifacts_immutable": true
  },
  "build_delta": {
    "required": true,
    "compare_to": "previous-successful-comparable-build",
    "output": "build-delta.json",
    "bundle_with_artifact": true,
    "dimensions": [
      "source",
      "dependencies",
      "toolchain",
      "configuration",
      "compatibility_migrations",
      "artifact_metrics",
      "validation"
    ]
  },
  "local_runtime": {
    "applicable": false,
    "bind_default": "loopback",
    "port_strategy": "configurable-with-collision-check",
    "foreground_default": true,
    "readiness_required": true,
    "graceful_shutdown_required": true,
    "verify_no_project_listener_after_stop": true
  },
  "ephemeral_resources": {
    "run_identity": true,
    "isolated_workspace": true,
    "cleanup_paths": ["success", "failure", "timeout", "cancellation", "interrupt", "partial-initialization"],
    "stale_resource_recovery": true,
    "ownership_required_before_cleanup": true,
    "post_cleanup_verification": true
  }
}
